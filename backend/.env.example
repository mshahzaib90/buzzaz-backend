PORT=5000
JWT_SECRET=your_jwt_secret_here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}
APIFY_TOKEN=your_apify_token_here
CRON_SCHEDULE=0 * * * *
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Firebase toggles
# Set to 'true' to disable Firebase routes regardless of service account presence
DISABLE_FIREBASE=false

# Postgres
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Optional Postgres SSL/pool tuning
PGSSL=false
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000

# Upload limits (in megabytes)
# Defaults to 10MB on Vercel/production, 50MB locally
MAX_UPLOAD_MB=10

# YouTube Data API
# Obtain an API key from Google Cloud Console and paste here.
# If missing or set to a placeholder, the backend will serve mock data.
YOUTUBE_API_KEY=your_youtube_data_api_key

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
